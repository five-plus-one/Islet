# Islet 部署配置模板
# 使用方法：复制本文件为 .env 并填写实际值
#   cp .env.example .env
#
# MySQL / Redis 连接信息与认证方式（OIDC / 本地账号）
# 不在此文件填写 —— 首次启动后通过管理端初始化向导完成。

# ===== 端口配置（可选，默认值如下）=====
# MySQL 对外暴露端口（本机已有 MySQL 时改为其他端口）
MYSQL_PORT=13306
# Redis 对外暴露端口
REDIS_PORT=16379
# 图床公网端口：图片访问 /i、缩略图 /t、Token 上传 API
APP_PORT=18090
# 管理端端口（初始化向导入口：http://127.0.0.1:18091）
ADMIN_PORT=18091

# ===== MySQL 密码（必填）=====
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
